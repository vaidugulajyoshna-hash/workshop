# Local development: Vite proxies /api to the Flask server.
VITE_BACKEND_URL=http://127.0.0.1:5000

# Production: set this to the deployed Flask service URL, for example:
# VITE_API_BASE_URL=https://your-workshop-api.onrender.com

# GitHub Pages subdirectory. The deployment workflow sets this automatically.
# VITE_BASE_PATH=/workshop/